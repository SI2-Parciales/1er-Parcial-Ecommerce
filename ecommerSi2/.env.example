# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - APLICACIÓN MÓVIL (EXPO / REACT NATIVE)
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo y renómbralo a '.env' en la raíz de esta carpeta (ecommerSi2).
#    Comando Windows PowerShell: Copy-Item .env.example .env
#    Comando Linux / Mac / Bash: cp .env.example .env
#
# 2. Elige la URL de tu API según dónde vayas a probar la app móvil:
#
#   A) Si pruebas en NAVEGADOR WEB (npm run web):
#      EXPO_PUBLIC_API_URL=http://localhost:1234
#
#   B) Si pruebas en EMULADOR ANDROID (Android Studio):
#      EXPO_PUBLIC_API_URL=http://10.0.2.2:1234
#
#   C) Si pruebas en TU CELULAR FÍSICO con Expo Go (conectado al mismo Wi-Fi de la PC):
#      Reemplaza 192.168.1.X por la IPv4 de tu computadora (obtenla con 'ipconfig'):
#      EXPO_PUBLIC_API_URL=http://192.168.1.50:1234
# ==============================================================================

# URL del Backend NestJS local (Puerto por defecto: 1234)
EXPO_PUBLIC_API_URL=http://localhost:1234

# Evitar advertencias de verificación entre React Navigation v7 y Expo Router
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1
