# PostgreSQL de desarrollo. Nunca subas el archivo .env real.
DATABASE_URL="postgresql://fashionstore:change-me@localhost:5432/fashionstore?schema=public"

# PostgreSQL exclusiva para pruebas E2E. Debe ser distinta de DATABASE_URL.
TEST_DATABASE_URL="postgresql://fashionstore:change-me@localhost:5432/fashionstore_test?schema=public"

# Usa una cadena aleatoria de al menos 32 caracteres en el entorno real.
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN="15m"
PORT=1234

# Orígenes web permitidos, separados por coma. React Native nativo no requiere CORS.
# En producción agrega aquí el dominio real del frontend, por ejemplo https://app.fashionstore.com
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Carpeta local para imágenes de productos. Las rutas relativas parten de la raíz del backend.
PRODUCT_IMAGES_DIR="uploads/productos"

# Datos de demostración. Se usan con `prisma:seed:demo` y `prisma:seed:inventario-demo`.
# Deben apuntar a una base distinta de DATABASE_URL y TEST_DATABASE_URL.
DEMO_SEED_ENABLED=false
DEMO_DATABASE_URL="postgresql://fashionstore:change-me@localhost:5432/fashionstore_demo?schema=public"
DEMO_USERS_PASSWORD="set-a-local-demo-password"
DEMO_CLIENTE_EMAIL="cliente.demo@example.test"
DEMO_CAJERO_EMAIL="cajero.demo@example.test"
DEMO_ENCARGADO_EMAIL="encargado.demo@example.test"
DEMO_ADMINISTRADOR_EMAIL="admin.demo@example.test"
